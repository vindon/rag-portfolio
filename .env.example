# =============================================================================
# RAG Portfolio — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (primary)
# Options: groq | openai | anthropic | gemini | mistral | cohere | huggingface | ollama
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq (recommended — free, fast, OpenAI-compatible)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini fallback (generous free tier — 1M tokens/day on Flash)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Ollama (fully local — fallback, no API key needed)
# Install: brew install ollama && ollama pull llama3.2
OLLAMA_LLM_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Embedding Provider (primary)
# Options: ollama | gemini | huggingface | openai
# -----------------------------------------------------------------------------
EMBED_PROVIDER=ollama

# Ollama local embeddings (recommended for M-series Mac — zero cost)
# Install: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Gemini embedding fallback
GEMINI_EMBED_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Model Gateway — additional providers (packages/model_gateway)
# All of these are optional; set LLM_PROVIDER_SECONDARY / LLM_PROVIDER_LOCAL /
# EMBED_PROVIDER_SECONDARY to activate fallback chains across providers.
# -----------------------------------------------------------------------------
# Secondary LLM provider to fall back to if the primary fails
LLM_PROVIDER_SECONDARY=
# Local LLM provider, tried last in the fallback chain (default: ollama)
LLM_PROVIDER_LOCAL=ollama
# Secondary embedding provider to fall back to if the primary fails
EMBED_PROVIDER_SECONDARY=

# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Mistral
# Get your key at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Cohere
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-r

# Hugging Face (chat via router + inference API embeddings)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Model gateway request tuning
MODEL_GATEWAY_TIMEOUT_SECONDS=30
MODEL_GATEWAY_MAX_RETRIES=2
MODEL_GATEWAY_RETRY_BASE_DELAY_SECONDS=0.5

# -----------------------------------------------------------------------------
# hr_policy domain (apps/api) -- requires a real Postgres for spend_guard
# -----------------------------------------------------------------------------
# Any reachable Postgres 14+ works locally (a local install, or Docker).
# In production this is the provisioned Supabase connection string.
DATABASE_URL=postgresql://localhost:5432/gateway_dev

# hr_policy uses Gemini for embeddings in production since Ollama isn't
# deployable on Render's free tier -- override the platform-wide default
# (EMBED_PROVIDER=ollama above) for this domain's deployment.
# EMBED_PROVIDER=gemini
# LLM_PROVIDER_SECONDARY=gemini

# -----------------------------------------------------------------------------
# Vector Databases
# -----------------------------------------------------------------------------
# Qdrant — used in Project 03
# :memory: = in-process (no Docker needed) | http://localhost:6333 = Docker
QDRANT_URL=:memory:

# Milvus — used in Project 04
# ./milvus.db = Milvus Lite embedded | http://localhost:19530 = Docker
MILVUS_URI=./milvus.db

# Weaviate — used in Project 05
# Leave blank for embedded mode (auto-start) | http://localhost:8080 = Docker
WEAVIATE_URL=

# -----------------------------------------------------------------------------
# Google Calendar — used in Project 05 (optional)
# Setup guide: https://developers.google.com/calendar/api/quickstart/python
# If not configured, the app runs in demo/mock mode automatically
# -----------------------------------------------------------------------------
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=4
